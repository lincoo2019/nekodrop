<Window x:Class="NekoDrop.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NekoDrop"
        Title="{local:T hist.title}" Width="520" Height="620" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource Text}" FontFamily="{DynamicResource UiFont}" FontSize="13">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="44"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,0,8,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource TitleButton}" Click="Close_Click" VerticalAlignment="Center"
                AutomationProperties.Name="Close">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,0,8,0"/>
          <TextBlock Text="{local:T hist.heading}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Filter & Search -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
      <DockPanel>
        <Border DockPanel.Dock="Left" Style="{StaticResource SegmentBox}" VerticalAlignment="Center" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="FilterAll" Style="{StaticResource Segment}" Content="{local:T hist.all}" GroupName="hfilter" IsChecked="True" Checked="Filter_Changed"/>
            <RadioButton x:Name="FilterReceived" Style="{StaticResource Segment}" Content="{local:T hist.received}" GroupName="hfilter" Checked="Filter_Changed"/>
            <RadioButton x:Name="FilterSent" Style="{StaticResource Segment}" Content="{local:T hist.sent}" GroupName="hfilter" Checked="Filter_Changed"/>
          </StackPanel>
        </Border>
        <Grid VerticalAlignment="Center">
          <TextBox x:Name="SearchBox" Style="{StaticResource WinTextBox}" Padding="10,5" TextChanged="Search_Changed"/>
          <TextBlock x:Name="SearchHint" Text="{local:T hist.search}" FontSize="12" Foreground="{DynamicResource Text3}"
                     Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
      </DockPanel>
    </Border>

    <!-- Records list -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16,12,16,12">
        <TextBlock x:Name="EmptyText" Text="{local:T hist.empty}" Style="{StaticResource Dim11}" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,48,0,0" Visibility="Collapsed"/>
        <ItemsControl x:Name="HistoryList">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="local:TransferRecord">
              <Border Style="{StaticResource WinCard}" Padding="12,10" Margin="0,0,0,8" ToolTip="{Binding TooltipText}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="copyBtn" Style="{StaticResource TitleButton}" Width="28" Height="28" Tag="{Binding}"
                            Click="Copy_Click" ToolTip="{local:T hist.copy}" Margin="0,0,4,0">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12"/>
                    </Button>
                    <Button x:Name="openBtn" Style="{StaticResource WinButton}" Content="{local:T main.open}" Tag="{Binding}"
                            Click="Open_Click" Padding="10,4" FontSize="11" Margin="0,0,4,0"/>
                    <Button x:Name="resendBtn" Style="{StaticResource WinButton}" Content="{local:T hist.resend}" Tag="{Binding}"
                            Click="Resend_Click" Padding="10,4" FontSize="11" Margin="0,0,4,0" Visibility="Collapsed"/>
                    <Button Style="{StaticResource TitleButton}" Width="24" Height="24" Tag="{Binding}" Click="Delete_Click"
                            ToolTip="{local:T set.remove}" AutomationProperties.Name="Remove">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9" Foreground="{DynamicResource Text3}"/>
                    </Button>
                  </StackPanel>
                  <TextBlock x:Name="glyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}"
                             Foreground="{DynamicResource Accent}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="detail" Text="{Binding DetailLine}" Style="{StaticResource Dim11}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanCopy}" Value="False">
                  <Setter TargetName="copyBtn" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CanOpen}" Value="False">
                  <Setter TargetName="openBtn" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CanResend}" Value="True">
                  <Setter TargetName="resendBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLink}" Value="True">
                  <Setter TargetName="openBtn" Property="Content" Value="{local:T hist.openLink}"/>
                  <Setter TargetName="copyBtn" Property="ToolTip" Value="{local:T hist.copyLink}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                  <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Error}"/>
                  <Setter TargetName="detail" Property="Foreground" Value="{DynamicResource Error}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="3" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,0">
      <DockPanel>
        <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="{local:T hist.clear}"
                Click="Clear_Click" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource Dim11}" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
