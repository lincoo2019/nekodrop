<Window x:Class="NekoDrop.WifiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NekoDrop"
        Title="{local:T wifi.title}" Width="420" Height="640" MinWidth="380" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource Text}" FontFamily="{DynamicResource UiFont}" FontSize="13">
  <Window.Resources>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource WinButton}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,0,8,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource TitleButton}" Click="Close_Click" VerticalAlignment="Center"
                AutomationProperties.Name="Close">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" Margin="0,0,8,0"/>
          <TextBlock Text="Wi-Fi" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Not in concurrent mode: Windows runs Wi-Fi -->
    <StackPanel x:Name="NotConcurrent" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" Visibility="Collapsed">
      <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Card}" BorderBrush="{DynamicResource BorderStrong}"
              BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" FontSize="22" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
      </Border>
      <TextBlock Text="{local:T wifi.notConcurrent}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock Text="{local:T wifi.notConcurrentHint}" FontSize="12" Foreground="{DynamicResource Text2}" TextAlignment="Center"
                 TextWrapping="Wrap" Margin="0,6,0,16"/>
      <Button Style="{StaticResource WinPrimary}" Content="{local:T wifi.switchMode}" Click="SwitchMode_Click" HorizontalAlignment="Center" Padding="16,8"/>
    </StackPanel>

    <ScrollViewer x:Name="Concurrent" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <!-- A network that wants a web sign-in -->
        <Border x:Name="PortalNotice" CornerRadius="8" Padding="12" Margin="0,0,0,16" Background="{DynamicResource WarnBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1" Visibility="Collapsed">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource WinButton}" Content="{local:T wifi.openLogin}" Click="Portal_Click" Margin="8,0,0,0"
                    VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock x:Name="PortalTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Warn}"/>
              <TextBlock Text="{local:T wifi.portal.body}" FontSize="12" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Current connection -->
        <TextBlock Text="{local:T wifi.current}" Style="{StaticResource Caption}"/>
        <Border x:Name="CurrentCard" Style="{StaticResource WinCard}" Padding="0" Margin="0,0,0,16">
          <Grid>
            <StackPanel Margin="14,12">
              <DockPanel>
                <Button x:Name="DisconnectButton" DockPanel.Dock="Right" Style="{StaticResource WinButton}" Content="{local:T wifi.disconnect}"
                        Click="Disconnect_Click" VerticalAlignment="Center"/>
                <TextBlock x:Name="StateGlyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE701;" FontSize="18"
                           Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                <StackPanel>
                  <TextBlock x:Name="StateTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="StateDetail" FontSize="12" Foreground="{DynamicResource Success}" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
              <StackPanel x:Name="AddressRow">
                <Border Style="{StaticResource Rule}" Margin="0,10,0,8"/>
                <DockPanel>
                  <TextBlock x:Name="GatewayText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Text2}"/>
                  <TextBlock x:Name="IpText" FontSize="12" Foreground="{DynamicResource Text2}"/>
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Nearby networks -->
        <DockPanel Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource Small}" Content="{local:T wifi.hiddenShort}" Click="ShowHidden_Click"/>
            <Button x:Name="RefreshButton" Style="{StaticResource Small}" Click="Refresh_Click" Margin="6,0,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="10" Margin="0,0,4,0"/>
                <TextBlock Text="{local:T wifi.refresh}"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Text="{local:T wifi.nearby}" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
          <TextBlock x:Name="ScanText" FontSize="11" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </DockPanel>
        <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>

        <!-- A hidden network -->
        <Border x:Name="HiddenForm" Style="{StaticResource WinCard}" Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
          <StackPanel>
            <TextBox x:Name="HiddenSsid" Style="{StaticResource WinTextBox}" FontSize="12" ToolTip="SSID" MaxLength="32"/>
            <DockPanel Margin="0,8,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource WinPrimary}" Content="{local:T wifi.connect}" Click="Hidden_Click" Margin="8,0,0,0"/>
              <PasswordBox x:Name="HiddenPassword" Style="{StaticResource WinPasswordBox}" ToolTip="{local:T wifi.password}"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border x:Name="EmptyCard" Style="{StaticResource WinCard}" Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{local:T wifi.empty}" FontSize="12" Foreground="{DynamicResource Text2}" TextAlignment="Center"/>
            <Button Style="{StaticResource WinButton}" Content="{local:T wifi.rescan}" Click="Refresh_Click" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="NetworkCard" Style="{StaticResource WinCard}" Margin="0,0,0,16">
          <StackPanel x:Name="NetworkList"/>
        </Border>

        <!-- Saved networks -->
        <TextBlock x:Name="SavedTitle" Style="{StaticResource Caption}"/>
        <Border Style="{StaticResource WinCard}">
          <StackPanel x:Name="SavedList"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
