<Window x:Class="NekoDrop.AppleIdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NekoDrop"
        Title="{local:T aid.signInTitle}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{DynamicResource Text}" FontFamily="{DynamicResource UiFont}" FontSize="13">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="56"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,0,8,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource TitleButton}" Click="Cancel_Click" VerticalAlignment="Center"
                AutomationProperties.Name="Close">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" Margin="0,0,8,0"/>
          <TextBlock Text="{local:T aid.signInTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="1" Margin="18,16,18,16">
      <TextBlock Text="{local:T aid.signInHint}" Style="{StaticResource Sub12}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <StackPanel x:Name="Credentials">
        <TextBlock Text="{local:T aid.email}" Style="{StaticResource T13S}" Margin="0,0,0,4"/>
        <TextBox x:Name="EmailBox" Style="{StaticResource WinTextBox}"/>
        <TextBlock Text="{local:T aid.password}" Style="{StaticResource T13S}" Margin="0,10,0,4"/>
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource WinPasswordBox}"/>
      </StackPanel>
      <StackPanel x:Name="CodePanel" Visibility="Collapsed">
        <TextBlock x:Name="CodeHint" Style="{StaticResource Sub12}" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBox x:Name="CodeBox" Style="{StaticResource WinTextBox}" MaxLength="8" FontFamily="Consolas" FontSize="16"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" Style="{StaticResource Sub12}" TextWrapping="Wrap" Margin="0,12,0,0"/>
      <ProgressBar x:Name="DownloadBar" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"
                   Foreground="{DynamicResource Accent}" Background="{DynamicResource Border}" BorderThickness="0"/>
    </StackPanel>

    <Border Grid.Row="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,0">
      <DockPanel VerticalAlignment="Center">
        <Button x:Name="ExportLogButton" DockPanel.Dock="Left" Style="{StaticResource QuietButton}" Content="{local:T aid.exportLog}"
                Click="ExportLog_Click" Padding="10,8" Visibility="Collapsed"/>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource WinButton}" Content="{local:T set.cancel}" Click="Cancel_Click" Padding="16,8" IsCancel="True"/>
          <Button x:Name="GoButton" Style="{StaticResource WinPrimary}" Content="{local:T aid.signIn}" Click="Go_Click" Padding="16,8"
                  Margin="8,0,0,0" IsDefault="True"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
